# Rendered at container start: the base image's entrypoint runs envsubst over this
# template, substituting ${EVALD_API_URL}. nginx's own runtime vars ($uri, $host, …)
# are not in the environment, so they pass through untouched.
server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Long-cache the content-addressed build assets.
    location /assets/ {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public";
    }

    # Reverse-proxy the evald API to a real store node. proxy_pass has no URI part, so the
    # original `/v1/...` path is forwarded verbatim.
    location /v1/ {
        proxy_pass ${EVALD_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # SQL / large trace reads
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # SPA fallback: unknown routes render the app shell (client-side nav owns the rest).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
